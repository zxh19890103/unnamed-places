{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@": [
        "src"
      ],
      "@/*": [
        "src/*"
      ]
    },
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "jsx": "react-jsx",
    "strictPropertyInitialization": false,
    "types": [
      "vitest/globals"
    ],
    "lib": [
      "ES2022",
      "DOM"
    ]
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules/@types/three/src/nodes/**/*.d.ts"
  ],
}