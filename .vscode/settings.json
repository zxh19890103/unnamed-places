{
  "editor.fontFamily": "Baloo Da 2",
  "editor.fontSize": 14,
  "workbench.fontAliasing": "antialiased",
  "editor.fontLigatures": true,
  "editor.fontWeight": "300",
  "window.zoomLevel": 1.8,
  "editor.letterSpacing": 2,
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/node_modules": false,
  },
  "markdown.preview.fontFamily": "Ubuntu Mono",
  "js/ts.tsdk.path": "./app/__deprecated/serve/node_modules/typescript/lib",
  "webgl-glsl-editor.diagnostics": false,
  "css.lint.unknownAtRules": "ignore",
}